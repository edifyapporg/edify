<%# locals: (title:, message:) %>
<%# Why an app can't be connected: impersonation, no MCP access, or a resource other than /mcp. %>
<div class="d-flex justify-content-center">
  <div class="card mt-4 w-100" style="max-width: 640px;">
    <div class="card-header">
      <h4 class="mb-0"><%= title %></h4>
    </div>
    <div class="card-body">
      <p class="mb-0"><%= message %></p>
    </div>
  </div>
</div>
