<%# locals: (api_tokens:) %>

<% if api_tokens.empty? %>
  <p class="text-muted mb-0">You have no API tokens.</p>
<% else %>
  <div class="table-responsive">
    <table class="table table-striped table-bordered" id="api_tokens">
      <thead>
      <tr>
        <th>Name</th>
        <th>Access</th>
        <th>Created</th>
        <th>Last used</th>
        <th>Expires</th>
        <th>Status</th>
        <th></th>
      </tr>
      </thead>
      <tbody>
      <%= render partial: "api_token", collection: api_tokens, as: :api_token %>
      </tbody>
    </table>
  </div>
<% end %>
