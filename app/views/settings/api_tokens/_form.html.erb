<%# locals: (api_token:) %>

<%= form_with(model: api_token, url: settings_api_tokens_path, scope: :api_token, data: { turbo: false }) do |f| %>
  <% if api_token.errors.any? %>
    <div id="error_explanation" class="alert alert-danger">
      <ul class="mb-0">
        <% api_token.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, "Name" %>
    <%= f.text_field :name, class: "form-control", maxlength: 100, placeholder: "e.g. Laptop CLI or Claude Code" %>
  </div>

  <div class="mb-3">
    <%= f.label :expires_in, "Expires after" %>
    <%= f.select :expires_in,
                 ::ApiToken::EXPIRY_CHOICES.keys.map { |code| [t("models.api_token.expiry_choices.#{code}"), code] },
                 {},
                 class: "form-select" %>
  </div>

  <div class="form-check mb-3">
    <%= f.check_box :guidance_acknowledged, class: "form-check-input" %>
    <%= f.label :guidance_acknowledged, class: "form-check-label sentence-label" do %>
      I understand that this token lets the Edify CLI and AI assistants read ward member information. I've reviewed
      the Church's guidance on member privacy and the use of AI tools in the
      <%= link_to "General Handbook", ::EdifyConfig.general_handbook_url, target: "_blank", rel: "noopener" %>,
      and I'll use this token accordingly.
    <% end %>
  </div>

  <%= f.submit "Create Token", class: "btn btn-primary" %>
<% end %>
